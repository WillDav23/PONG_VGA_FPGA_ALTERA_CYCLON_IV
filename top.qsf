##  CONFIGURACIÓN DE PROYECTO agregar en el archivo top.qsf ##

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10E22C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY build

# Señales de clock y reset
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_60 -to rst # H1_2

# Señales de Sincornizacion
set_location_assignment PIN_64 -to hsync_o # H1_3
set_location_assignment PIN_65 -to vsync_o # H1_4

# Canales de Color (1 bit por cada variable separada)
set_location_assignment PIN_66 -to r_o # H1_5
set_location_assignment PIN_67 -to g_o # H1_6
set_location_assignment PIN_68 -to b_o # H1_7
set_location_assignment PIN_69 -to clk_o # H1_8


#Señal relevante del modulo HC-06
set_location_assignment PIN_74 -to UART_RX



set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
