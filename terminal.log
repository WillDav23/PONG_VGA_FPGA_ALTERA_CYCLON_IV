[?2004l
## SIMULACIÓN Y RTL ##
	make rtl 	-> Crear el RTL desde el TOP
	make sim 	-> Simular diseño
	make wave 	-> Ver simulación en gtkwave
	make log-rtl 	-> Ver el log del RTL. Comandos: /palabra -> buscar, n -> próxima palabra, q -> salir, h -> salir

Ejemplos de simulaciones con más argumentos:
	make sim VVP_ARG=+inputs=5		:Agregar un argumento a la simulación
	make sim VVP_ARG=+a=5\ +b=6		:Agregar varios argumentos a la simulación
	make sim VVP_ARG+=+a=5 VVP_ARG+=+b=6	:Agregar varios argumentos a la simulación
	make rtl top=modulo1			:Obtiene el RTL de otros modulos (submodulos)
	make rtl rtl2png			:Convertir el RTL del TOP desde formato svg a png
	make rtl rtl2png top=modulo1		:Además de convertir, obtiene el RTL de otros modulos (submodulos)
	make ConvertOneVerilogFile		:Crear un único verilog del diseño

## SINTESIS Y CONFIGURACIÓN ##
	make syn		-> Sintetizar diseño
	make log-syn		-> Resumen de resultados del proceso de sínstesis
	make config		-> Configurar fpga desde cram
	make config-flash	-> Configurar flash memory
	make erase-flash	-> Borrar memoria flash (debe tener un archivo build/top.jic)
	make clean		-> Limipiar síntesis si ha modificado el diseño
	make fpga-detect	-> Detectar fpga
